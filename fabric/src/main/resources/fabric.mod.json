{
  "schemaVersion": 1,
  "id": "armor_model_api",
  "version": "${version}",
  "name": "Armor Model API",
  "description": "Renders armor with custom geometry authored in the Bedrock/GeckoLib geo format, through the vanilla armor rendering pipeline.",
  "authors": [
    "ZsoltMolnarrr"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.rpg_foundation.armor_api.fabric.ArmorModelApiFabric"
    ],
    "client": [
      "net.rpg_foundation.armor_api.fabric.client.ArmorModelApiFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-rendering-v1": "*",
    "fabric-resource-loader-v0": "*"
  }
}
