{
  "schemaVersion": 1,
  "id": "armor_model_api",
  "version": "${version}",
  "name": "Armor Model API",
  "description": "Renders Bedrock/GeckoLib geo armor models through the vanilla armor pipeline.",
  "authors": [
    "Daedelus"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/armor_model_api/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.rpg_foundation.armor_api.fabric.ArmorModelApiFabric"
    ],
    "client": [
      "net.rpg_foundation.armor_api.fabric.client.ArmorModelApiFabricClient"
    ]
  },
  "mixins": [
    "armor_model_api-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=${minecraft_min_version}",
    "java": ">=25",
    "fabric-rendering-v1": "*",
    "fabric-resource-loader-v1": "*"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ]
    }
  }
}
